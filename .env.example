# ---------------------------------------------------------------------------
# Market-data service configuration. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Redis connection. docker-compose overrides the host to `redis`.
REDIS_URL=redis://localhost:6379/0

# Sweep pacing (keeps us well under provider rate limits)
POLL_INTERVAL_SECONDS=60        # gap between subscription sweeps
QUOTE_BATCH_SIZE=10             # instrument keys per LTP request
BATCH_PAUSE_SECONDS=1.0         # pause between batches within a sweep
INSTRUMENT_REFRESH_HOUR=8       # local hour to refresh the instrument master

# ---- Upstox ------------------------------------------------------------
# Generate at account.upstox.com/developer/apps -> Analytics tab -> Generate
# Token. Read-only, valid for a year — no daily login/refresh needed.
UPSTOX_ACCESS_TOKEN=

# Debug logging. The sweep runs every POLL_INTERVAL_SECONDS, so per-batch/
# per-quote detail (requests to Upstox, batch sizes, quote counts) is only
# logged, at DEBUG level, when this is true. Logs always go to stdout and to
# logs/market-data.log at the repo root either way.
VERBOSE=false

# ---------------------------------------------------------------------------
# Portfolio service configuration.
# ---------------------------------------------------------------------------

# Postgres credentials — used both to start the `postgres` container and to
# build the portfolio service's DATABASE_URL in docker-compose.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# Only used when running the portfolio service outside docker-compose
# (compose overrides this to point at the `postgres` container).
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# SearchStock: max results returned per query.
SEARCH_RESULT_LIMIT=5

# Postgres backups (pg_dump on a timer). Set to 0 to disable.
BACKUP_DIR=/backups
BACKUP_INTERVAL_MINUTES=10
BACKUP_RETENTION=12

# ---------------------------------------------------------------------------
# Screener service (on demand: docker compose --profile screener up -d screener).
# ---------------------------------------------------------------------------

# Seconds between requests to NSE. Lower is faster but risks being blocked;
# the first full back-fill takes a few hours at 0.4.
NSE_REQUEST_DELAY=0.4
# History kept per stock: full years (growth, 5Y averages) and quarters (TTM).
HISTORY_YEARS=6
HISTORY_QUARTERS=8
